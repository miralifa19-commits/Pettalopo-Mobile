rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'miralifa19@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function protectedProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'peran', 'isAdmin', 'isDewan', 'dewanJabatan', 'statusKeanggotaan', 'nonaktif']);
    }

    // Private profile: only the owner and primary admin can read it.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(userId)
          && (!('role' in request.resource.data) || request.resource.data.role == 'anggota')
          && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
          && (!('isDewan' in request.resource.data) || request.resource.data.isDewan == false)
          && (!('dewanJabatan' in request.resource.data) || request.resource.data.dewanJabatan == '')
          && (!('peran' in request.resource.data) || request.resource.data.peran == 'anggota')
          && (!('statusKeanggotaan' in request.resource.data) || request.resource.data.statusKeanggotaan != 'admin')
          && (!('nonaktif' in request.resource.data) || request.resource.data.nonaktif == false));
      allow update: if isAdmin() || (isOwner(userId) && protectedProfileFieldsUnchanged());
      allow delete: if isAdmin();
    }

    // Limited member directory. It contains no birth date, phone number,
    // home address, credentials, or private account metadata.
    match /public_members/{userId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isOwner(userId)
          && (!('role' in request.resource.data) || request.resource.data.role == 'anggota')
          && (!('isDewan' in request.resource.data) || request.resource.data.isDewan == false)
          && (!('dewanJabatan' in request.resource.data) || request.resource.data.dewanJabatan == '')
          && request.resource.data.keys().hasOnly([
            'uid', 'nama', 'namaLengkap', 'gudep', 'satuan', 'tingkat',
            'sangga', 'jabatan', 'foto', 'fotoUrl', 'role', 'isDewan',
            'dewanJabatan', 'updatedAt'
          ]));
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isDewan', 'dewanJabatan'])
          && request.resource.data.keys().hasOnly([
            'uid', 'nama', 'namaLengkap', 'gudep', 'satuan', 'tingkat',
            'sangga', 'jabatan', 'foto', 'fotoUrl', 'role', 'isDewan',
            'dewanJabatan', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    match /config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /test/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /attendance_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /attendance_records/{recordId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /program_kerja/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /materi_belajar/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /active_kegiatan/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ambalan_notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ambalan_chats/{chatId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.senderId == request.auth.uid);
    }
    match /kegiatan_evaluations/{evaluationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Public Ambalan identity; changes are restricted to the existing primary admin.
    match /ambalan_profile/{profileId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Fallback: no other path is accessible unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
