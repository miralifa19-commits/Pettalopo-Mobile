rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Only the explicitly trusted primary administrator can manage shared data.
    // Add other administrators through a server-controlled custom claim in a later step.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'miralifa19@gmail.com',
          'amiruddin@smpialwasi-maros.sch.id'
        ];
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function protectedProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'peran', 'isAdmin', 'isDewan', 'dewanJabatan', 'statusKeanggotaan', 'nonaktif']);
    }

    // Connection probe: authenticated clients only.
    match /test/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Profiles: signed-in members may view the directory, but can only
    // create/update their own profile. Privileged role fields are admin-only.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == 'anggota')
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && (!('isDewan' in request.resource.data) || request.resource.data.isDewan == false)
        && (!('dewanJabatan' in request.resource.data) || request.resource.data.dewanJabatan == '')
        && (!('peran' in request.resource.data) || request.resource.data.peran == 'anggota')
        && (!('statusKeanggotaan' in request.resource.data) || request.resource.data.statusKeanggotaan != 'admin')
        && (!('nonaktif' in request.resource.data) || request.resource.data.nonaktif == false)
        || isAdmin();
      allow update: if (isOwner(userId) && protectedProfileFieldsUnchanged())
        || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin directory and access configuration are not public.
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
    match /config/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Shared app content: all authenticated members may read; only admin writes.
    match /attendance_sessions/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /program_kerja/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /materi_belajar/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /active_kegiatan/{sessionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /ambalan_notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Attendance: a member can submit/update only their own record.
    // Admin can review and manage all records.
    match /attendance_records/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Chat: authenticated members can read; senders own their messages.
    match /ambalan_chats/{chatId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    // Evaluations are shared records; writes are restricted to the admin.
    match /kegiatan_evaluations/{evaluationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // No unspecified collection or document is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
